{
  "name": "piano-invaders",
  "version": "1.0.0",
  "description": "A retro-styled rhythm game that combines Space Invaders gameplay with piano-based music mechanics. Shoot falling musical notes by pressing the correct piano keys at the right time!",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:lib": "echo 'library build defined in Task 10' && exit 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "game",
    "piano",
    "music",
    "react",
    "rhythm"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "ivories": "^0.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "smplr": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "serve": "^14.2.6",
    "typescript": "~6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-canvas-mock": "^1.2.0"
  }
}
